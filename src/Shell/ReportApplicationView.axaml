<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:report="clr-namespace:JunexisLang.Studio.CompilerExtension;assembly=JunexisLang.CompilerExtension"
             x:DataType="report:ReportApplicationViewModel"
             x:Class="Junexis.Studio.Shell.ReportApplicationView">
    <ScrollViewer>
        <StackPanel Margin="12" Spacing="12">
            <StackPanel Spacing="3">
                <TextBlock Text="Aplikacja Junexis" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="server + @report" Opacity="0.72" />
            </StackPanel>

            <Border Padding="10" CornerRadius="5"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="7">
                    <TextBlock Text="Stan" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Url}" TextWrapping="Wrap" FontFamily="Consolas"
                               FontSize="11" Opacity="0.84" />
                </StackPanel>
            </Border>

            <WrapPanel Orientation="Horizontal">
                <Button Classes="subtle" Content="Uruchom" Click="Start_OnClick" IsEnabled="{Binding CanStart}"
                        Margin="0,0,6,6" />
                <Button Classes="subtle" Content="Otwórz panel" Click="Open_OnClick" IsEnabled="{Binding CanOpen}"
                        Margin="0,0,6,6" />
                <Button Classes="subtle" Content="Zatrzymaj" Click="Stop_OnClick" IsEnabled="{Binding CanStop}"
                        Margin="0,0,6,6" />
            </WrapPanel>

            <TextBlock Text="Studio najpierw sprawdza projekt. Błędy języka i view.json trafiają do Problemów; dopiero poprawny system jest budowany i uruchamiany."
                       TextWrapping="Wrap" Opacity="0.72" FontSize="11" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
