<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Junexis.Studio.Shell.TextPromptWindow"
        Width="420"
        Height="170"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Prompt">
    <Grid RowDefinitions="Auto,Auto,*" Margin="16">
        <TextBlock x:Name="PromptMessage"
                   TextWrapping="Wrap" />
        <TextBox x:Name="PromptInput"
                 Grid.Row="1"
                 Margin="0,12,0,0" />
        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="Cancel" Click="OnCancel" MinWidth="88" IsCancel="True" />
            <Button Content="OK" Click="OnConfirm" MinWidth="88" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>